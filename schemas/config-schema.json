{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cloudflare Workers LLM Proxy Configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "PROXY_API_KEY": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "CLOUDFLARE_ACCOUNT_ID": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "AI_GATEWAY_NAME": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!\\.{1,2}$)[^/?#\\u0000-\\u001F\\u007F]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ALWAYS_USE_AI_GATEWAY": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "CF_AIG_TOKEN": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "CLOUDFLARE_API_TOKEN": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "OPENAI_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "GEMINI_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ANTHROPIC_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "CEREBRAS_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "COHERE_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "CLINE_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "DEEPSEEK_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "GROK_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "GROQ_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "MISTRAL_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "NVIDIA_NIM_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "OPENROUTER_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "HUGGINGFACE_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "PERPLEXITYAI_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "REPLICATE_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "CLOUDFLARE_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "OLLAMA_API_KEY": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "AZURE_OPENAI_API_KEY": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "AZURE_OPENAI_RESOURCE_NAME": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "AZURE_OPENAI_API_VERSION": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "GOOGLE_VERTEX_AI_SERVICE_ACCOUNT_JSON": {
      "oneOf": [
        { "$ref": "#/definitions/googleVertexServiceAccount" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/googleVertexServiceAccount" }
        },
        { "type": "null" }
      ]
    },
    "AWS_BEARER_TOKEN_BEDROCK": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "null" }
      ]
    },
    "AWS_BEDROCK_REGION": {
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },

    "DEV": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "DEFAULT_MODEL": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ENABLE_GLOBAL_ROUND_ROBIN": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "CUSTOM_OPENAI_ENDPOINTS": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://"
          },
          "apiKeys": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "models": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "chatCompletionPath": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^/(?:[^/].*)?$"
          },
          "modelsPath": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^/(?:[^/].*)?$"
          }
        },
        "required": ["name", "baseUrl"]
      }
    }
  },
  "required": ["$schema", "PROXY_API_KEY"],
  "allOf": [
    {
      "if": {
        "properties": {
          "ALWAYS_USE_AI_GATEWAY": { "const": true }
        },
        "required": ["ALWAYS_USE_AI_GATEWAY"]
      },
      "then": {
        "properties": {
          "CLOUDFLARE_ACCOUNT_ID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "CLOUDFLARE_API_TOKEN": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
      }
    }
  ],
  "definitions": {
    "googleVertexServiceAccount": {
      "type": "object",
      "required": [
        "type",
        "project_id",
        "private_key",
        "client_email",
        "region"
      ],
      "properties": {
        "type": { "const": "service_account" },
        "project_id": { "type": "string", "minLength": 1 },
        "private_key": { "type": "string", "minLength": 1 },
        "client_email": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
