{
  "$schema": "schemas/config-schema.json",

  // --- General Authentication ---
  // API Key for llm proxy.
  "PROXY_API_KEY": "YOUR-PROXY-API-KEY",

  // --- AI Gateway ---
  "CLOUDFLARE_ACCOUNT_ID": null,
  "AI_GATEWAY_NAME": null,
  // Route every upstream provider request through AI Gateway. Uses the
  // "default" Gateway when AI_GATEWAY_NAME is null.
  "ALWAYS_USE_AI_GATEWAY": false,
  "CF_AIG_TOKEN": null,
  // Cloudflare API token with AI Gateway permission for /ai/* REST API routes
  // and AI Gateway Write permission for Custom Provider synchronization.
  "CLOUDFLARE_API_TOKEN": null,

  // --- API keys for providers ---
  // OpenAI: https://platform.openai.com/
  "OPENAI_API_KEY": null,
  // Google AI Studio: https://aistudio.google.com/
  "GEMINI_API_KEY": null,
  // Anthropic: https://console.anthropic.com/
  "ANTHROPIC_API_KEY": null,
  // Cerebras: https://cloud.cerebras.ai/
  "CEREBRAS_API_KEY": null,
  // Cohere: https://dashboard.cohere.com
  "COHERE_API_KEY": null,
  // DeepSeek: https://platform.deepseek.com/
  "DEEPSEEK_API_KEY": null,
  // xAI: https://console.x.ai/
  "GROK_API_KEY": null,
  // Groq: https://console.groq.com/
  "GROQ_API_KEY": null,
  // Mistral: https://console.mistral.ai/
  "MISTRAL_API_KEY": null,
  // OpenRouter: https://openrouter.ai/
  "OPENROUTER_API_KEY": null,
  // HuggingFace: https://huggingface.co/
  "HUGGINGFACE_API_KEY": null,
  // Perplexity AI: https://www.perplexity.ai/
  "PERPLEXITYAI_API_KEY": null,
  // Replicate: https://replicate.com/
  "REPLICATE_API_KEY": null,
  // Cloudflare Workers AI: https://dash.cloudflare.com/
  "CLOUDFLARE_API_KEY": null,
  // Ollama Cloud: https://ollama.com/
  "OLLAMA_API_KEY": null,
  // Azure OpenAI: https://azure.microsoft.com/products/ai-services/openai-service
  "AZURE_OPENAI_API_KEY": null,
  "AZURE_OPENAI_RESOURCE_NAME": null,
  "AZURE_OPENAI_API_VERSION": "2024-10-21",
  // Google Vertex AI through Cloudflare AI Gateway.
  // Paste the downloaded service-account JSON and add "region": "us-central1".
  "GOOGLE_VERTEX_AI_SERVICE_ACCOUNT_JSON": null,
  // Amazon Bedrock: https://aws.amazon.com/bedrock/
  // Use an Amazon Bedrock short-term or long-term bearer token.
  // AI Gateway BYOK may omit it.
  "AWS_BEARER_TOKEN_BEDROCK": null,
  "AWS_BEDROCK_REGION": "us-east-1",

  // --- Custom OpenAI Compatible Endpoints ---
  "CUSTOM_OPENAI_ENDPOINTS": [
    // {
    //   "name": "my-custom-llm",
    //   "baseUrl": "https://llm.example.com/v1",
    //   "apiKeys": [],
    //   "models": ["model-1", "model-2"] // Optional
    //   "chatCompletionPath": "/v1/chat/completions", // Optional
    //   "modelsPath": "/v1/models" // Optional
    // }
  ],

  // --- Configurations ---
  "DEV": false,
  "DEFAULT_MODEL": null,
  "ENABLE_GLOBAL_ROUND_ROBIN": false
}
