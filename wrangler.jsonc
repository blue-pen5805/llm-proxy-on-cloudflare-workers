// This file is used to configure the Cloudflare Workers project using Wrangler.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-proxy",
  "main": "src/index.ts",
  // Compatibility dates
  // Docs: https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-07-16",
  // Compatibility flags
  // Docs: https://developers.cloudflare.com/workers/configuration/compatibility-flags/
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Workers Logs
  // Docs: https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  // Smart Placement
  // Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/
  // This Worker is subrequest-dominated (provider fan-out, Gateway fallback
  // chains) with geographically concentrated upstreams, so placement near the
  // upstream reduces per-round-trip latency. Cloudflare reverts automatically
  // if analysis finds placement makes this Worker slower.
  "placement": {
    "mode": "smart"
  },
  // Durable Object migration history. v1.1 deletes the KeyRotationManager
  // that coordinated global key rotation before rotation became striped and
  // isolate-local; deletion destroys its stored counters, which are
  // disposable. The v1.0 tag must remain so existing deployments can apply
  // the deletion incrementally.
  "migrations": [
    {
      "tag": "v1.0",
      "new_sqlite_classes": ["KeyRotationManager"]
    },
    {
      "tag": "v1.1",
      "deleted_classes": ["KeyRotationManager"]
    }
  ]
}
